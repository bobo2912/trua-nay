rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi nhóm nằm dưới groups/<mã nhóm>. Mã nhóm dài và ngẫu nhiên, ai có link nhóm mới đọc/ghi được.
    // Không có quy tắc cho chính /groups nên không ai liệt kê được danh sách các nhóm.
    match /groups/{group}/{col}/{docId} {
      allow read, write: if request.auth != null
        && group.size() >= 16
        && col in ['people', 'places', 'bills', 'polls', 'votes', 'config'];
    }
  }
}
