rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Máy này có giữ chìa khóa của hồ sơ pid không
    function owns(pid) {
      return signedIn()
        && exists(/databases/$(database)/documents/keys/$(pid))
        && request.auth.uid in get(/databases/$(database)/documents/keys/$(pid)).data.uids;
    }

    // Chìa khóa hồ sơ: chỉ máy đã đăng ký đọc được; máy mới vào được khi nhập đúng mã khôi phục
    match /keys/{pid} {
      allow get: if signedIn() && request.auth.uid in resource.data.uids;
      allow create: if signedIn() && pid.size() >= 16
        && request.resource.data.keys().hasOnly(['secret', 'uids'])
        && request.resource.data.secret is string
        && request.resource.data.secret.size() >= 20
        && request.resource.data.uids == [request.auth.uid];
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['secret', 'uids'])
        && request.resource.data.secret == resource.data.secret
        && request.resource.data.uids.hasAll(resource.data.uids)
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() <= resource.data.uids.size() + 1
        && request.resource.data.uids.size() <= 30;
    }

    // Hồ sơ công khai (tên, Zalo, ngân hàng để tạo QR): ai biết mã thì xem, chỉ chủ sửa
    match /profiles/{pid} {
      allow get: if signedIn();
      allow write: if owns(pid);
      // Hộp bill của từng người: chỉ chủ đọc; người tạo bill được ghi bản sao vào
      match /bills/{bid} {
        allow read: if owns(pid);
        allow write: if signedIn();
      }
      // Danh bạ, quán, cài đặt riêng: chỉ chủ
      match /{col}/{docId} {
        allow read, write: if owns(pid) && col in ['contacts', 'places', 'private'];
      }
    }

    // Bill và bình chọn: ai có link (mã dài ngẫu nhiên) thì xem và cập nhật; không ai liệt kê được
    match /bills/{bid} {
      allow get, write: if signedIn() && bid.size() >= 16;
    }
    match /polls/{id} {
      allow get, write: if signedIn() && id.size() >= 16;
      match /votes/{vid} {
        allow read, write: if signedIn();
      }
    }
  }
}
